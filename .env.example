# Which GPU serves inference: "modal" (serverless A100) or "local" (this machine's
# own NVIDIA GPU, in-process). Defaults to "modal" when unset, so an existing
# deployment behaves exactly as before. The UI can override it per session when
# both are available — see backend/services/inference.py.
INFERENCE_BACKEND=modal

# Modal — get from modal.com dashboard. Required only for INFERENCE_BACKEND=modal.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Local GPU backend only. Optional: path to a YOLO .pt file. Left unset, the
# weights are pulled from HuggingFace (goktug14/yolov5_kvasir_polyp) and cached.
# Needs backend/requirements-gpu.txt installed.
# POLYP_WEIGHTS=/opt/polyp/weights/best.pt

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
