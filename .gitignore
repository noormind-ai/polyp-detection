# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
.env
.env.local

# Node
node_modules/
.next/
out/

# Data — large training sets and videos, not tracked in git.
# Spelled "data/*" rather than "data/" so the small tooling and label files
# under it can be re-included: git cannot un-ignore a file whose parent
# DIRECTORY is excluded, only one whose contents are. With the old "data/"
# rule, new scripts here were silently dropped from commits.
data/*
!data/*.py
!data/samples/
data/samples/*
!data/samples/ground_truth/

# Runtime data written by the backend — captured clinical frames and clips, and
# registered accounts (password hashes). Never committed. This used to be
# covered only by accident: the bare "data/" rule above matched at any depth,
# so narrowing it to the repo root would have started tracking these.
backend/data/

# Logs
logs/

# Modal
.modal/

# Uploads
/tmp/polyp-uploads/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# local build/runtime artifacts (not for the repo)
venv/
frontend/.next.bak-*/
frontend/frontend.log
.git.broken-bak/

frontend/tsconfig.tsbuildinfo
backend/.env.bak-*
