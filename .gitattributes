# Files that are executed or parsed on Linux must keep LF endings regardless of
# the platform they were edited on. A CRLF bootstrap.sh fails on a fresh box with
# a bare "\r: command not found", which is a miserable thing to debug.
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
deploy/*        text eol=lf

# Benchmark output is compared across runs; normalising it stops line-ending
# churn from showing up as a 1200-line diff on an unchanged file.
*.csv           text eol=lf
